# ── Node ────────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*

# ── Python ──────────────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── Build outputs ───────────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Databases & local storage ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Uploads (serverless writes to /tmp; keep the gitkeep marker only) ──────────
uploads/*
!uploads/.gitkeep

# ── Environment & secrets ────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Vercel ──────────────────────────────────────────────────────────────────────
.vercel

# ── Misc ────────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
*.tsbuildinfo
*.log
coverage/
